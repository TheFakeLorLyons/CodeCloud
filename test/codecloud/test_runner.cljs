(ns codecloud.test-runner
  "Runs every CodeCloud test namespace on Node and reports failure through
  the process exit code."
  (:require [cljs.test :as test]
            [codecloud.agents.cloud-tools-test]
            [codecloud.agents.hub-test]
            [codecloud.agents.mcp-test]
            [codecloud.agents.presence-test]
            [codecloud.agents.roster-test]
            [codecloud.agents.tools-test]
            [codecloud.assistant.conversation-test]
            [codecloud.assistant.providers-test]
            [codecloud.assistant.runner-test]
            [codecloud.counting-test]
            [codecloud.io.analyzer-test]
            [codecloud.io.file-server-test]
            [codecloud.io.mcp-http-test]
            [codecloud.io.mcp-stdio-test]
            [codecloud.io.nrepl-test]
            [codecloud.io.ports-test]
            [codecloud.io.task-test]
            [codecloud.io.theme-files-test]
            [codecloud.io.tree-sitter-test]
            [codecloud.languages.c-family-test]
            [codecloud.languages-test]
            [codecloud.model.complection-test]
            [codecloud.model.config-test]
            [codecloud.model.graph-test]
            [codecloud.model.ignore-test]
            [codecloud.model.ignored-test]
            [codecloud.model.new-file-test]
            [codecloud.model.ns-form-test]
            [codecloud.model.parse-test]
            [codecloud.model.resolution-test]
            [codecloud.model.uses-test]
            [codecloud.model.workspace-test]
            [codecloud.presentation.arrangement-test]
            [codecloud.presentation.assistant-state-test]
            [codecloud.presentation.clojure-format-test]
            [codecloud.presentation.code-colors-test]
            [codecloud.presentation.definitions-test]
            [codecloud.presentation.editing-state-test]
            [codecloud.presentation.environments-test]
            [codecloud.presentation.focus-test]
            [codecloud.presentation.forms-state-test]
            [codecloud.presentation.ignored-state-test]
            [codecloud.presentation.layers-test]
            [codecloud.presentation.markdown-test]
            [codecloud.presentation.page-commands-test]
            [codecloud.presentation.pairing-test]
            [codecloud.presentation.presence-state-test]
            [codecloud.presentation.presentation-test]
            [codecloud.presentation.repl-state-test]
            [codecloud.presentation.terminal-test]
            [codecloud.presentation.ui-state-test]
            [codecloud.presentation.visibility-test]
            [codecloud.presentation.windows-state-test]
            [codecloud.vscode.calva-test]
            [codecloud.vscode.repl-host-test]))

(defmethod test/report [:cljs.test/default :end-run-tests] [summary]
  (set! (.-exitCode js/process) (if (test/successful? summary) 0 1)))

(defn main []
  (test/run-all-tests #"codecloud\..*-test"))

(set! *main-cli-fn* main)
