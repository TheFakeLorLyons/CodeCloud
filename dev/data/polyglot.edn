);\n    if (index === 0) {\n      context.moveTo(index, y);\n    } else {\n      context.lineTo(index, y);\n    }\n  });\n  context.stroke();\n}\n"}], "app.core" [{:path "src/app/core.cljs", :language :clojure, :text "(ns app.core\n  (:require [\"../../web/js/plot.js\" :as plot]\n            [app.state :as state]))\n\n(defn render! [canvas]\n  (plot/plot canvas (:samples @state/db)))\n"}], "bin/run.sh" [{:path "bin/run.sh", :language :shell, :text "#!/bin/bash\n# Records a session, trains on it, and reports.\nset -euo pipefail\n\nDIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nsource \"$DIR/env.sh\"\n\nrecord() {\n  local minutes=\"$1\"\n  if [[ -z \"$minutes\" ]]; then\n    echo \"usage: run.sh minutes\" >&2\n    return 1\n  fi\n  python scripts/train.py \"$PORT\" &\n  wait\n}\n\nrecord \"${1:-5}\"\nbb tasks/report.clj\n./bin/deploy\ncat <<EOF\nFinished. Don't forget to \"upload\" the results.\nEOF\necho \"$#\"\n"}], "src/eeg/stream.py" [{:path "src/eeg/stream.py", :language :python, :text "\"\"\"Streams samples from a board.\"\"\"\nimport asyncio\n\nfrom eeg import board\nfrom eeg.filters import bandpass\n\nBUFFER_SIZE = 256\n_streams = []\n\n\nclass Stream:\n    \"\"\"A running stream of filtered samples.\"\"\"\n\n    def __init__(self, port):\n        self.port = port\n        self.buffer = []\n\n    async def read(self):\n        raw = await board.read_samples(self.port, BUFFER_SIZE)\n        filtered = bandpass(raw, 1, 50, board.RATE)\n        self.buffer.extend(filtered)\n        return filtered\n\n\ndef open_stream(port):\n    global _streams\n    stream = Stream(port)\n    _streams.append(stream)\n    asyncio.get_event_loop().create_task(stream.read())\n    return stream\n"}], "web/scss/_mixins.scss" [{:path "web/scss/_mixins.scss", :language :css, :text "@mixin raised {\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);\n}\n"}], "bin/deploy" [{:path "bin/deploy", :language :shell, :text "#!/usr/bin/env bash\nrsync -a web/ server:/srv/www/\n"}], "native/cpp/ring.h" [{:path "native/cpp/ring.h", :language :cpp, :text "#pragma once\n#include <cstddef>\n\nnamespace eeg {\n\ntemplate <typename T, std::size_t Size>\nclass Ring {\n public:\n  void push(T value) {\n    items_[next_] = value;\n    next_ = (next_ + 1) % Size;\n  }\n\n private:\n  T items_[Size] = {};\n  std::size_t next_ = 0;\n};\n\n}  // namespace eeg\n"}], "web/index.html" [{:path "web/index.html", :language :html, :text "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Signal viewer</title>\n  <link rel=\"stylesheet\" href=\"css/main.css\">\n  <link rel=\"modulepreload\" href=\"/js/plot.js\">\n  <style>\n    body { margin: 0; }\n  </style>\n</head>\n<body>\n  <!-- The chart fills the page,\n       and the link below leads to the credits. -->\n  <canvas id=\"chart\" width=\"800\" height=\"400\"></canvas>\n  <a href=\"about.html\">About &amp; credits</a>\n  <script type=\"module\" src=\"js/app.js\"></script>\n  <script>\n    window.addEventListener(\"load\", () => console.log(\"ready </p>\"));\n  </script>\n</body>\n</html>\n"}], "scripts/train.py" [{:path "scripts/train.py", :language :python, :text "#!/usr/bin/env python3\n\"\"\"Trains a classifier on recorded sessions.\"\"\"\nimport sys\n\nfrom eeg import Stream\nfrom eeg.filters import notch\n\n\ndef main(arguments):\n    stream = Stream(arguments[1])\n    return notch(stream.buffer, 60, 250)\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv))\n"}], "src/eeg/filters.py" [{:path "src/eeg/filters.py", :language :python, :text "\"\"\"Filters applied to raw EEG samples.\"\"\"\nimport math\n\nimport numpy as np\n\n\ndef bandpass(samples, low, high, rate):\n    \"\"\"Keeps the frequencies between low and high.\"\"\"\n    nyquist = rate / 2\n    if low <= 0 or high >= nyquist:\n        raise ValueError(\"band outside the signal\")\n    window = np.hanning(len(samples))\n    return [sample * weight for sample, weight in zip(samples, window)]\n\n\ndef notch(samples, frequency, rate):\n    \"\"\"Removes one frequency, such as mains hum.\"\"\"\n    angle = 2 * math.pi * frequency / rate\n    return [sample - math.cos(angle) * sample for sample in samples]\n\n\ndef adaptive(samples, rate, history):\n    \"\"\"Chooses a filter for each entry of recent history.\"\"\"\n    result = samples\n    for entry in history:\n        if entry.kind == \"hum\":\n            result = notch(result, entry.frequency, rate)\n        elif entry.kind == \"drift\":\n            result = bandpass(result, 0.5, 40, rate)\n        elif entry.kind == \"spike\":\n            if entry.size > 100:\n                result = [min(sample, 100) for sample in result]\n            else:\n                for index, sample in enumerate(result):\n                    if sample > entry.size:\n                        result[index] = entry.size\n        while len(result) > rate * 10:\n            result = result[rate:]\n    return result\n"}], "web/css/base.css" [{:path "web/css/base.css", :language :css, :text "/* Type and spacing shared by every page. */\nbody {\n  font-family: system-ui, sans-serif;\n  background: url(https://example.com/paper.png);\n}\n"}], "native/cpp/main.cpp" [{:path "native/cpp/main.cpp", :language :cpp, :text "#include <cstdio>\n#include \"Board.hpp\"\n#include \"filter.h\"\n\nnamespace {\n\ndouble smoothed(eeg::Board& board) {\n  double total = 0.0;\n  for (double sample : board.read(4)) {\n    total += filter_sample(sample, 0.5);\n  }\n  return total;\n}\n\n}  // namespace\n\nint main() {\n  eeg::Board board(\"/dev/ttyUSB0\");\n  if (!board.open()) {\n    return 1;\n  }\n  std::printf(\"%f\\n\", smoothed(board));\n  return 0;\n}\n"}], "web/js/util.ts" [{:path "web/js/util.ts", :language :typescript, :text "export interface Window {\n  size: number;\n}\n\nexport function smooth(samples: number[], size: number): number[] {\n  const result: number[] = [];\n  for (let index = 0; index < samples.length; index++) {\n    const start = Math.max(0, index - size);\n    const slice = samples.slice(start, index + 1);\n    result.push(slice.reduce((total, value) => total + value, 0) / slice.length);\n  }\n  return result;\n}\n"}], "src/eeg/board.py" [{:path "src/eeg/board.py", :language :python, :text "\"\"\"Talks to the board over a serial port.\"\"\"\nimport time\n\nfrom eeg.stream import BUFFER_SIZE\n\nRATE = 250\n_connection = None\n\n\ndef connect(port):\n    global _connection\n    _connection = port\n    time.sleep(0.1)\n    return _connection\n\n\nasync def read_samples(port, count=BUFFER_SIZE):\n    if _connection is None:\n        connect(port)\n    return [0.0] * count\n"}], "web/about.html" [{:path "web/about.html", :language :html, :text "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <link rel=\"stylesheet\" href=\"css/main.css\">\n</head>\n<body>\n  <p class=\"credits\"\n     title=\"Made with care\">Back to the <a href=\"index.html\">viewer</a>.</p>\n</body>\n</html>\n"}], "src/eeg/__init__.py" [{:path "src/eeg/__init__.py", :language :python, :text "\"\"\"Signal tools for EEG boards.\"\"\"\nfrom .filters import bandpass, notch\nfrom .stream import Stream\n\n__all__ = [\"bandpass\", \"notch\", \"Stream\"]\n"}], "web/css/main.css" [{:path "web/css/main.css", :language :css, :text "@import \"base.css\";\n@import url(\"theme.css\");\n\n.chart {\n  border: 1px solid #ccc;\n  margin: 0 auto;\n}\n\n.chart:hover {\n  border-color: #333;\n  cursor: pointer;\n}\n"}], "web/css/theme.css" [{:path "web/css/theme.css", :language :css, :text ":root {\n  --accent: #4f8fd8;\n}\n"}], "app.state" [{:path "src/app/state.cljs", :language :clojure, :text "(ns app.state)\n\n(defonce db (atom {:samples []}))\n"}], "web/scss/app.scss" [{:path "web/scss/app.scss", :language :css, :text "@use \"sass:math\";\n@use \"mixins\";\n\n// Charts sit on a card.\n.card {\n  @include mixins.raised;\n  padding: math.div(24px, 2);\n\n  &:hover {\n    opacity: 0.9;\n  }\n}\n"}], "native/cpp/Board.cpp" [{:path "native/cpp/Board.hpp", :language :cpp, :text "#pragma once\n#include <string>\n#include <thread>\n#include <vector>\n#include \"ring.h\"\n\nnamespace eeg {\n\nclass Board {\n public:\n  explicit Board(std::string port);\n  std::vector<double> read(std::size_t count);\n  void stream(std::size_t count);\n  bool open() const { return !port_.empty(); }\n\n private:\n  std::string port_;\n  Ring<double, 8> recent_;\n};\n\n}  // namespace eeg\n"} {:path "native/cpp/Board.cpp", :language :cpp, :text "#include \"Board.hpp\"\n\nnamespace eeg {\n\nBoard::Board(std::string port) : port_(std::move(port)) {}\n\nstd::vector<double> Board::read(std::size_t count) {\n  std::vector<double> samples(count, 0.0);\n  for (std::size_t index = 0; index < count; ++index) {\n    samples[index] = index % 2 == 0 ? 1.0 : -1.0;\n  }\n  return samples;\n}\n\nvoid Board::stream(std::size_t count) {\n  std::thread worker([this, count] { read(count); });\n  worker.detach();\n}\n\n}  // namespace eeg\n"}], "native/cpp/Board_test.cpp" [{:path "native/cpp/Board_test.cpp", :language :cpp, :text "#include <gtest/gtest.h>\n#include \"Board.hpp\"\n\nTEST(BoardTest, ReadsAsManySamplesAsAsked) {\n  eeg::Board board(\"loopback\");\n  EXPECT_EQ(board.read(3).size(), 3u);\n}\n"}], "report" [{:path "tasks/report.clj", :language :clojure, :text "(ns report\n  (:require [babashka.process :refer [shell]]\n            [clojure.string :as string]))\n\n(defn summary [lines]\n  (string/join \"\\n\" (take 5 lines)))\n\n(shell \"bash bin/env.sh\")\n(println (summary [\"done\"]))\n"}], "web/js/app.js" [{:path "web/js/app.js", :language :javascript, :text "import { plot } from \"./plot.js\";\nimport { smooth } from \"./util\";\nimport * as THREE from \"three\";\n\nconst canvas = document.getElementById(\"chart\");\nconst pattern = /\"(\\w+)\"/g;\n\nexport async function start() {\n  const response = await fetch(\"/samples.json\");\n  const samples = await response.json();\n  plot(canvas, smooth(samples, 4));\n  setTimeout(start, 1000 / 2);\n  return new THREE.Clock()