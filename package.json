{
  "name": "codecloud",
  "displayName": "CodeCloud",
  "description": "See a codebase as pages of real code floating among folder clouds, colored by folder or language, and zoom between the cloud and the editor.",
  "version": "0.4.3",
  "publisher": "lorelailyons",
  "author": "Lorelai Lyons",
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheFakeLorLyons/codecloud"
  },
  "galleryBanner": {
    "color": "#4f8fd8",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "clojure",
    "clojurescript",
    "python",
    "javascript",
    "c++",
    "visualization",
    "dependencies",
    "namespaces",
    "architecture"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "codecloud.cloud",
        "displayName": "CodeCloud",
        "selector": [
          {
            "filenamePattern": "*.cld"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "codecloud",
        "aliases": [
          "CodeCloud",
          "codecloud"
        ],
        "extensions": [
          ".cld"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/cld-file.svg",
          "dark": "./media/cld-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "codecloud",
        "scopeName": "source.codecloud",
        "path": "./syntaxes/codecloud.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "codecloud.enter",
        "title": "Enter Cloud View",
        "category": "CodeCloud",
        "icon": "$(cloud)"
      },
      {
        "command": "codecloud.zoomOut",
        "title": "Zoom Out Toward the Cloud",
        "category": "CodeCloud",
        "icon": "$(zoom-out)"
      },
      {
        "command": "codecloud.zoomIn",
        "title": "Zoom Back In",
        "category": "CodeCloud",
        "icon": "$(zoom-in)"
      },
      {
        "command": "codecloud.createCloudFile",
        "title": "Create Cloud Here",
        "category": "CodeCloud"
      },
      {
        "command": "codecloud.editCloudFile",
        "title": "Edit Cloud Settings",
        "category": "CodeCloud",
        "icon": "$(settings-gear)"
      },
      {
        "command": "codecloud.refresh",
        "title": "Refresh Cloud",
        "category": "CodeCloud",
        "icon": "$(refresh)"
      },
      {
        "command": "codecloud.showOnlyInCloud",
        "title": "Show Only These in the Cloud",
        "category": "CodeCloud"
      },
      {
        "command": "codecloud.hideInCloud",
        "title": "Hide in the Cloud",
        "category": "CodeCloud"
      },
      {
        "command": "codecloud.showEverything",
        "title": "Show Everything in the Cloud",
        "category": "CodeCloud"
      },
      {
        "command": "codecloud.openInCloud",
        "title": "Open in the Cloud",
        "category": "CodeCloud",
        "icon": "$(window)"
      },
      {
        "command": "codecloud.showWebPage",
        "title": "Show a Web Page in the Cloud",
        "category": "CodeCloud",
        "icon": "$(globe)"
      },
      {
        "command": "codecloud.runCommandForPage",
        "title": "Run a Command for the Page",
        "category": "CodeCloud"
      },
      {
        "command": "codecloud.connectAgent",
        "title": "Connect an Agent",
        "category": "CodeCloud",
        "icon": "$(radio-tower)"
      },
      {
        "command": "codecloud.chooseAssistantModel",
        "title": "Choose the Assistant's Model",
        "category": "CodeCloud",
        "icon": "$(sparkle)"
      },
      {
        "command": "codecloud.evaluateForm",
        "title": "Evaluate the Form at the Caret",
        "category": "CodeCloud"
      },
      {
        "command": "codecloud.evaluateEnclosingForm",
        "title": "Evaluate the Enclosing Form",
        "category": "CodeCloud"
      },
      {
        "command": "codecloud.evaluateTopLevelForm",
        "title": "Evaluate the Top-Level Form",
        "category": "CodeCloud"
      },
      {
        "command": "codecloud.evaluateToCaret",
        "title": "Evaluate the Enclosing Form up to the Caret",
        "category": "CodeCloud"
      },
      {
        "command": "codecloud.evaluateTopLevelFormToCaret",
        "title": "Evaluate the Top-Level Form up to the Caret",
        "category": "CodeCloud"
      },
      {
        "command": "codecloud.evaluateFileToCaret",
        "title": "Evaluate the File up to the Caret",
        "category": "CodeCloud"
      },
      {
        "command": "codecloud.loadFile",
        "title": "Load/Evaluate Current File",
        "category": "CodeCloud"
      },
      {
        "command": "codecloud.loadFileWithRequires",
        "title": "Load/Evaluate Current File and Its Requires/Dependencies",
        "category": "CodeCloud"
      },
      {
        "command": "codecloud.interruptEvaluations",
        "title": "Interrupt the Evaluations",
        "category": "CodeCloud"
      },
      {
        "command": "codecloud.clearInlineResults",
        "title": "Clear Inline Results",
        "category": "CodeCloud"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "codecloud.hub",
        "label": "CodeCloud"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codecloud.enter",
          "when": "resourceExtname =~ /^\\.(bash|bb|c|c\\+\\+|c\\+\\+m|cc|ccm|cjs|clj|cljc|cljd|cljr|cljs|cpp|cppm|cs|css|cts|cxx|cxxm|gemspec|go|h|h\\+\\+|hh|hpp|htm|html|hxx|inl|ipp|ixx|java|jl|js|jsx|ksh|kt|kts|less|lua|mjs|mpp|mts|php|py|pyi|pyw|r|rake|rb|rs|sass|scss|sh|tpp|ts|tsx|xhtml|zsh)$/i",
          "group": "navigation@90"
        },
        {
          "command": "codecloud.editCloudFile",
          "when": "activeCustomEditorId == codecloud.cloud",
          "group": "navigation@90"
        },
        {
          "command": "codecloud.refresh",
          "when": "activeCustomEditorId == codecloud.cloud",
          "group": "navigation@91"
        }
      ],
      "editor/context": [
      {
        "command": "codecloud.evaluateForm",
        "when": "editorLangId == clojure && codecloud.inCloud",
        "group": "codecloud@1"
      },
      {
        "command": "codecloud.evaluateTopLevelForm",
        "when": "editorLangId == clojure && codecloud.inCloud",
        "group": "codecloud@2"
      },
      {
        "command": "codecloud.loadFile",
        "when": "editorLangId == clojure && codecloud.inCloud",
        "group": "codecloud@3"
      },
      {
        "command": "codecloud.loadFileWithRequires",
        "when": "editorLangId == clojure && codecloud.inCloud",
        "group": "codecloud@4"
      }
    ],
    "explorer/context": [
        {
          "command": "codecloud.showOnlyInCloud",
          "group": "codecloud@1"
        },
        {
          "command": "codecloud.hideInCloud",
          "group": "codecloud@2"
        },
        {
          "command": "codecloud.createCloudFile",
          "when": "explorerResourceIsFolder",
          "group": "codecloud@3"
        },
        {
          "command": "codecloud.openInCloud",
          "when": "resourceExtname =~ /^\\.(avif|bmp|gif|htm|html|jpeg|jpg|markdown|md|pdf|png|svg|webp)$/i && !explorerResourceIsFolder",
          "group": "codecloud@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "codecloud.openInCloud",
          "when": "resourceExtname =~ /^\\.(avif|bmp|gif|htm|html|jpeg|jpg|markdown|md|pdf|png|svg|webp)$/i",
          "group": "codecloud@1"
        }
      ],
      "commandPalette": [
        {
          "command": "codecloud.showOnlyInCloud",
          "when": "false"
        },
        {
          "command": "codecloud.hideInCloud",
          "when": "false"
        },
        {
          "command": "codecloud.zoomIn",
          "when": "codecloud.zoomedOut"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codecloud.runCommandForPage",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "activeCustomEditorId == 'codecloud.cloud'"
      },
      {
        "command": "codecloud.zoomOut",
        "key": "ctrl+alt+-",
        "mac": "cmd+alt+-",
        "linux": "ctrl+shift+alt+-",
        "when": "editorTextFocus && resourceExtname =~ /^\\.(bash|bb|c|c\\+\\+|c\\+\\+m|cc|ccm|cjs|cld|clj|cljc|cljd|cljr|cljs|cpp|cppm|cs|css|cts|cxx|cxxm|edn|gemspec|go|h|h\\+\\+|hh|hpp|htm|html|hxx|inl|ipp|ixx|java|jl|js|jsx|ksh|kt|kts|less|lua|mjs|mpp|mts|php|py|pyi|pyw|r|rake|rb|rs|sass|scss|sh|tpp|ts|tsx|xhtml|zsh)$/i"
      },
      {
        "command": "codecloud.zoomIn",
        "key": "ctrl+alt+=",
        "mac": "cmd+alt+=",
        "linux": "ctrl+shift+alt+=",
        "when": "editorTextFocus && codecloud.zoomedOut"
      },
      {
        "command": "codecloud.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "editorTextFocus && config.codecloud.useStandardZoomKeys && codecloud.inCloud && resourceExtname =~ /^\\.(bash|bb|c|c\\+\\+|c\\+\\+m|cc|ccm|cjs|cld|clj|cljc|cljd|cljr|cljs|cpp|cppm|cs|css|cts|cxx|cxxm|edn|gemspec|go|h|h\\+\\+|hh|hpp|htm|html|hxx|inl|ipp|ixx|java|jl|js|jsx|ksh|kt|kts|less|lua|mjs|mpp|mts|php|py|pyi|pyw|r|rake|rb|rs|sass|scss|sh|tpp|ts|tsx|xhtml|zsh)$/i"
      },
      {
        "command": "codecloud.zoomOut",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "editorTextFocus && config.codecloud.useStandardZoomKeys && codecloud.inCloud && resourceExtname =~ /^\\.(bash|bb|c|c\\+\\+|c\\+\\+m|cc|ccm|cjs|cld|clj|cljc|cljd|cljr|cljs|cpp|cppm|cs|css|cts|cxx|cxxm|edn|gemspec|go|h|h\\+\\+|hh|hpp|htm|html|hxx|inl|ipp|ixx|java|jl|js|jsx|ksh|kt|kts|less|lua|mjs|mpp|mts|php|py|pyi|pyw|r|rake|rb|rs|sass|scss|sh|tpp|ts|tsx|xhtml|zsh)$/i"
      },
      {
        "command": "codecloud.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "editorTextFocus && config.codecloud.useStandardZoomKeys && codecloud.zoomedOut"
      },
      {
        "command": "codecloud.zoomIn",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "editorTextFocus && config.codecloud.useStandardZoomKeys && codecloud.zoomedOut"
      },
      {
        "command": "codecloud.evaluateForm",
        "key": "ctrl+enter",
        "when": "editorTextFocus && editorLangId == clojure && codecloud.inCloud && !calva:keybindingsEnabled && !calva:connected"
      },
      {
        "command": "codecloud.evaluateEnclosingForm",
        "key": "ctrl+shift+enter",
        "when": "editorTextFocus && editorLangId == clojure && codecloud.inCloud && !calva:keybindingsEnabled && !calva:connected"
      },
      {
        "command": "codecloud.evaluateTopLevelForm",
        "key": "alt+enter",
        "when": "editorTextFocus && editorLangId == clojure && codecloud.inCloud && !calva:keybindingsEnabled && !calva:connected"
      },
      {
        "command": "codecloud.evaluateToCaret",
        "key": "ctrl+alt+enter",
        "when": "editorTextFocus && editorLangId == clojure && codecloud.inCloud && !calva:keybindingsEnabled && !calva:connected"
      },
      {
        "command": "codecloud.evaluateTopLevelFormToCaret",
        "key": "shift+alt+enter",
        "when": "editorTextFocus && editorLangId == clojure && codecloud.inCloud && !calva:keybindingsEnabled && !calva:connected"
      },
      {
        "command": "codecloud.evaluateFileToCaret",
        "key": "ctrl+shift+alt+enter",
        "when": "editorTextFocus && editorLangId == clojure && codecloud.inCloud && !calva:keybindingsEnabled && !calva:connected"
      },
      {
        "command": "codecloud.loadFile",
        "key": "ctrl+alt+c enter",
        "when": "editorTextFocus && editorLangId == clojure && codecloud.inCloud && !calva:keybindingsEnabled && !calva:connected"
      },
      {
        "command": "codecloud.loadFileWithRequires",
        "key": "ctrl+alt+c shift+enter",
        "when": "editorTextFocus && editorLangId == clojure && codecloud.inCloud && !calva:keybindingsEnabled && !calva:connected"
      },
      {
        "command": "codecloud.interruptEvaluations",
        "key": "ctrl+alt+c ctrl+alt+d",
        "when": "editorTextFocus && editorLangId == clojure && codecloud.inCloud && !calva:keybindingsEnabled && !calva:connected"
      },
      {
        "command": "codecloud.clearInlineResults",
        "key": "escape",
        "when": "codecloud.hasInlineResults && editorTextFocus && editorLangId == clojure && !editorHasSelection && !editorHasMultipleSelections && !editorReadOnly && !selectionAnchorSet && !hasOtherSuggestions && !suggestWidgetVisible && !parameterHintsVisible && !inlineSuggestionVisible && !findWidgetVisible && !inSnippetMode"
      }
    ],
    "configuration": {
      "title": "CodeCloud",
      "properties": {
        "codecloud.zoomOutThreshold": {
          "type": "number",
          "default": 150,
          "minimum": 100,
          "maximum": 200,
          "markdownDescription": "How far to zoom out of a source file before its cloud opens, in percent, as with the zoom of a map. At `150` the cloud opens once code has shrunk to two thirds of its size, on the fourth press of the zoom-out key; at `200` it opens at half size; at `100` it opens on the first press."
        },
        "codecloud.useStandardZoomKeys": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Let the usual zoom keys (`Ctrl+-` and `Ctrl+=`) zoom files a cloud covers toward the cloud and back, so leaving the cloud and returning to it take the same keys. Everywhere else they keep zooming the whole window."
        },
        "codecloud.sky": {
          "type": "string",
          "default": "simple",
          "anyOf": [
            {
              "enum": [
                "simple",
                "auto",
                "day",
                "twilight",
                "night",
                "clock",
                "backrooms",
                "night-library"
              ],
              "enumDescriptions": [
                "A plain backdrop, folders as flat discs, and 30 frames a second, easy on large codebases and modest computers.",
                "Follow the editor theme: a day sky with light themes and a night sky with dark ones.",
                "Always a day sky.",
                "Always a sunset sky, with night pages.",
                "Always a night sky.",
                "Follow the local time of day, with dusk and dawn between.",
                "Yellow wallpaper, damp carpet, and humming lights, room after room.",
                "Dark wood, red carpet, and warm lamps, aisle after aisle."
              ]
            },
            {
              "type": "string",
              "description": "The name of a space in codecloud.spaces."
            }
          ],
          "markdownDescription": "What the cloud floats in. `simple` draws the least, for large codebases and modest computers, the skies draw clouds, sun, moon, and stars, `backrooms` draws an endless office, `night-library` a library after closing time, and the name of a space in `#codecloud.spaces#` draws that space. The sky button in the cloud changes this setting too, and resting the pointer on it lists every choice."
        },
        "codecloud.simpleColor": {
          "type": "string",
          "default": "",
          "pattern": "^(#[0-9a-fA-F]{3}|#[0-9a-fA-F]{6})?$",
          "patternErrorMessage": "A color such as #1b2340, or nothing for the editor theme's colors.",
          "markdownDescription": "The color of the **Simple** backdrop overhead, such as `#1b2340`, brightening toward the horizon. Pages take their day look on a light color and their night look on a dark one. Empty follows the editor theme. The color row under the sky button's list changes this setting too."
        },
        "codecloud.toolbarColors": {
          "type": [
            "string",
            "object"
          ],
          "default": "colored",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
          },
          "markdownDescription": "The colors of the icons at the top right of the cloud. `colored` gives each icon a color of its own, and `plain` draws every icon in the text color, white with dark themes. The Views pane's **Color the toolbar's icons** switches between `colored` and `plain`. An object names colors over the built-in ones, by `search`, `newFile`, `views`, `arrange`, `repl`, `agents`, `assistant`, `windows`, `grid`, `environment`, `wholeCloud`, and `legend`, with `all` for every icon it leaves out, so `{\"all\": \"#ffffff\"}` makes them all white."
        },
        "codecloud.pageCommands": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string",
                "description": "The command's name in a page's right-click menu."
              },
              "command": {
                "type": "string",
                "description": "A VS Code command's id, run with the page's file in the editor at the caret, as from the file's own editor."
              },
              "args": {
                "description": "What the command receives, as a keybinding's args give it."
              },
              "shell": {
                "type": "string",
                "description": "A command line run in a terminal in the cloud's folder, with ${file}, ${relativeFile}, and ${line} put in."
              },
              "window": {
                "type": [
                  "string",
                  "integer"
                ],
                "description": "A web address, or a port on this computer, to show in a window once the command has run."
              }
            }
          },
          "markdownDescription": "Commands each page's right-click menu offers for its file. A `command` runs with the file in the editor at the caret, so commands that read the editor, such as Calva's, work on the page; a `shell` command line runs in a terminal. A `window` shows that address, or a port on this computer, once the command has run, as `{\"title\": \"Clay: show this file\", \"command\": \"calva.runCustomREPLCommand\", \"args\": {\"snippet\": \"(scicloj.clay.v2.api/make! {:source-path \\\"$file\\\"})\"}, \"window\": 1971}` does. **Run a command…** in the same menu runs any other command."
        },
        "codecloud.spaces": {
          "type": "array",
          "default": [],
          "markdownDescription": "Spaces for the cloud to float in, each one room or rooms in every direction, chosen from the sky button's list or named in `#codecloud.sky#`. Colors are written as `#rrggbb`, and each surface wears one of the patterns `plain`, `stripes`, `grid`, `tiles`, `checks`, `dots`, `carpet`, or `wallpaper`.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "What the sky button's list calls the space, and what codecloud.sky takes to choose it."
              },
              "layout": {
                "type": "string",
                "enum": [
                  "room",
                  "maze"
                ],
                "default": "room",
                "enumDescriptions": [
                  "One room around the cloud.",
                  "Rooms in every direction, with walls placed at random between them."
                ]
              },
              "light": {
                "type": "string",
                "enum": [
                  "day",
                  "twilight",
                  "night",
                  "clock",
                  "theme"
                ],
                "default": "day",
                "description": "Whether pages and panels take their day or night look, follow the time of day, or follow the editor theme."
              },
              "walls": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "type": "string",
                    "description": "The surface's color, as #rrggbb."
                  },
                  "pattern": {
                    "type": "string",
                    "enum": [
                      "plain",
                      "stripes",
                      "grid",
                      "tiles",
                      "checks",
                      "dots",
                      "carpet",
                      "wallpaper"
                    ],
                    "default": "plain",
                    "description": "What the surface wears."
                  },
                  "patternColor": {
                    "type": "string",
                    "description": "The color of the pattern's lines, tiles, or marks, as #rrggbb."
                  },
                  "patternScale": {
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 8,
                    "default": 1,
                    "description": "How large the pattern is drawn, 1 being its usual size."
                  }
                }
              },
              "floor": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "type": "string",
                    "description": "The surface's color, as #rrggbb."
                  },
                  "pattern": {
                    "type": "string",
                    "enum": [
                      "plain",
                      "stripes",
                      "grid",
                      "tiles",
                      "checks",
                      "dots",
                      "carpet",
                      "wallpaper"
                    ],
                    "default": "plain",
                    "description": "What the surface wears."
                  },
                  "patternColor": {
                    "type": "string",
                    "description": "The color of the pattern's lines, tiles, or marks, as #rrggbb."
                  },
                  "patternScale": {
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 8,
                    "default": 1,
                    "description": "How large the pattern is drawn, 1 being its usual size."
                  }
                }
              },
              "ceiling": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "color": {
                    "type": "string",
                    "description": "The surface's color, as #rrggbb."
                  },
                  "pattern": {
                    "type": "string",
                    "enum": [
                      "plain",
                      "stripes",
                      "grid",
                      "tiles",
                      "checks",
                      "dots",
                      "carpet",
                      "wallpaper"
                    ],
                    "default": "plain",
                    "description": "What the surface wears."
                  },
                  "patternColor": {
                    "type": "string",
                    "description": "The color of the pattern's lines, tiles, or marks, as #rrggbb."
                  },
                  "patternScale": {
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 8,
                    "default": 1,
                    "description": "How large the pattern is drawn, 1 being its usual size."
                  }
                }
              },
              "lamps": {
                "type": [
                  "string",
                  "boolean"
                ],
                "description": "The color of the lamps in the ceiling, as #rrggbb, or false for none."
              },
              "haze": {
                "type": "string",
                "description": "The color the far parts of the space fade into, as #rrggbb."
              },
              "folders": {
                "type": "string",
                "enum": [
                  "clouds",
                  "discs",
                  "none"
                ],
                "default": "clouds",
                "description": "Whether folders gather in billowing clouds, in flat discs, or not at all."
              }
            }
          }
        },
        "codecloud.editorColors": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Color code on pages with the editor theme's syntax colors, font styles, and bracket pair colors in place of CodeCloud's own. Each color moves in lightness only as far as it must to read on the sky. The Editor theme colors switch in the Arrange panel changes this setting too."
        },
        "codecloud.historyLimit": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 400,
          "description": "Most commits the cloud's timeline offers."
        },
        "codecloud.agents.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Serve CodeCloud's tools to AI agents over MCP from a hub inside VS Code, which agents reach with a token. **CodeCloud: Connect an Agent** connects Claude Code, opencode, Codex, VS Code's own agents, or any other MCP client."
        },
        "codecloud.agents.address": {
          "type": "string",
          "default": "127.0.0.1",
          "markdownDescription": "The address the agent hub listens on. `127.0.0.1` keeps it to this computer; `0.0.0.0` lets agents in virtual machines, containers, or on other computers reach it, each still needing the token."
        },
        "codecloud.agents.port": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "markdownDescription": "The port the agent hub listens on. At `0` the hub takes a free port the first time and keeps it for the workspace, so connected agents find it again; another number asks for that port."
        },
        "codecloud.assistant.cacheLifetime": {
          "type": "string",
          "enum": [
            "5m",
            "1h"
          ],
          "enumDescriptions": [
            "Five minutes. Writing to the cache costs 1.25 times the input price.",
            "An hour. Writing costs twice the input price, which pays off when questions often come more than five minutes apart."
          ],
          "default": "5m",
          "markdownDescription": "How long Anthropic keeps the assistant's conversation cached between turns. Reading from the cache costs a tenth of the input price or less, so each turn after the first pays mostly for what is new. CodeCloud's output channel shows the tokens each reply read from the cache."
        },
        "codecloud.agents.reporting": {
          "type": "string",
          "enum": [
            "full",
            "agents",
            "brief",
            "off"
          ],
          "enumDescriptions": [
            "Agents and their subagents report each file they start on and what they intend, and agents may leave pins and ask who else is at work.",
            "Agents report each file and what they intend; subagents leave reporting to them.",
            "Agents report once per task, without lines; subagents report nothing, and agents can no longer leave pins or ask who else is at work.",
            "No agent reports, and the reporting tools are withdrawn."
          ],
          "default": "full",
          "markdownDescription": "How much agents connected to the hub report about their work, also set from the Coworkers pane. Each report costs the agent tokens, so quieter levels cost less, and at every level the cloud still shows what agents read through the hub and the changes they make. Connected agents list their tools again at once; the hub's instructions reach agents that connect afterwards."
        },
        "codecloud.agents.wavescopeBands": {
          "type": "string",
          "enum": [
            "fine",
            "all"
          ],
          "enumDescriptions": [
            "The exact lines nearest the line asked about, which costs agents the fewest tokens.",
            "The exact lines, the signatures and sections further out, and the strongest peaks nearby, which help agents find their way in a large codebase."
          ],
          "default": "fine",
          "markdownDescription": "How much of wavescope's view around a line `query_wavelet_context` and `get_cursor_context` give agents, also set from the Coworkers pane."
        }
      }
    }
